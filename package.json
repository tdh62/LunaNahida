  "scripts": {
    "dev": "concurrently -k \"go run ./cmd/devserver\" \"vite\"",
    "dev:api": "go run ./cmd/devserver",
    "dev:ui": "vite",
    "dev:web": "vite --mode web",
    "build": "vite build",
    "build:web": "vite build --mode web",
    "test:frontend": "node --experimental-transform-types --test src/lib/*.test.mjs",
    "test:web": "vite build --mode web && node --experimental-transform-types scripts/verify-web.mjs",
    "build:desktop": "vite build && node scripts/build-desktop.mjs",
    "build:converter": "node scripts/build-converter.mjs",
    "test:converter:integration": "node scripts/test-converter-integration.mjs",
    "build:desktop:full": "vite build && node scripts/build-desktop.mjs --with-converter",
    "build:portable:full": "vite build && node scripts/build-portable.mjs --with-converter",
    "build:portable": "vite build && node scripts/build-portable.mjs",
    "build:version": "node scripts/version.mjs",
    "check:version": "node scripts/version.mjs --check",
    "build:release": "node scripts/build-release.mjs",
    "build:release:lean": "node scripts/build-release.mjs --lean-only",
    "build:release:portable": "node scripts/build-release.mjs --portable",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview"
  },
